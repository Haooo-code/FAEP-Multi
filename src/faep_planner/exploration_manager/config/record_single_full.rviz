Panels:
- Class: rviz/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Planning1
    - /active_perception1
    - /active_perception1/frontier1
    - /active_perception1/frontier1/Namespaces1
    - /active_perception1/viewpoint1/Namespaces1
    - /LocalMap1
    - /LocalMap1/occupied_local1/Autocompute Value Bounds1
    - /LocalMap1/occupied_all1/Autocompute Value Bounds1
    - /Simulation1
    - /debug21/Autocompute Value Bounds1
    - /processed_msg1/Namespaces1
    - /Image1
    - /PointCloud21/Autocompute Value Bounds1
    Splitter Ratio: 0.5216138362884521
  Tree Height: 420
- Class: rviz/Selection
  Name: Selection
- Class: rviz/Tool Properties
  Expanded:
  - /2D Pose Estimate1
  - /2D Nav Goal1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz/Views
  Expanded:
  - /Current View1
  - /ThirdPersonFollower1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 40
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz/Group
    Name: Scene Map
    Enabled: true
    Value: true
    Displays:
    - Alpha: 0.22
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2.5
        Min Value: -0.2
        Value: false
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 150; 155; 165
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: global_obstacles
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.055
      Style: Flat Squares
      Topic: /map_generator/global_cloud
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
  - Class: rviz/Group
    Name: Local Maps
    Enabled: true
    Value: true
    Displays:
    - Alpha: 0.28
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 1.25
        Min Value: -2
        Value: false
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 31; 119; 180
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 0; 0; 0
      Min Color: 0; 0; 0
      Name: drone1_local_map
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.065
      Style: Flat Squares
      Topic: /sdf_map/occupancy_all
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
  - Class: rviz/Group
    Name: Camera FOV
    Enabled: true
    Value: true
    Displays:
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /planning/position_cmd_vis
      Name: drone1_fov
      Namespaces: {}
      Queue Size: 20
      Value: true
  - Class: rviz/Group
    Name: Trajectories
    Enabled: true
    Value: true
    Displays:
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /planning/travel_traj
      Name: drone1_trajectory
      Namespaces: {}
      Queue Size: 20
      Value: true
  - Class: rviz/Group
    Name: Robots
    Enabled: true
    Value: true
    Displays:
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /odom_visualization/robot
      Name: drone1_robot
      Namespaces: {}
      Queue Size: 20
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
    Hide Inactive Objects: true
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  - Class: rviz/SetInitialPose
    Theta std deviation: 0.2617993950843811
    Topic: /initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
  - Class: rviz/SetGoal
    Topic: /move_base_simple/goal
  - Class: rviz/PublishPoint
    Single click: true
    Topic: /clicked_point
  Value: true
  Views:
